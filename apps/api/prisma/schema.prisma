// Calendar Management - Prisma Schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// EVENT STATUS
// ============================================================

enum EventStatus {
  SAVED
  SCHEDULED
  PUBLISHED
  PAUSED
  CLOSED
  CANCELLED
}

// ============================================================
// EVENT
// ============================================================

model Event {
  id String @id @default(cuid())

  title       String
  subtitle    String?
  description String?

  startDate DateTime
  endDate   DateTime
  startTime String?
  endTime   String?

  location   String?
  priority   String?
  attachment String?

  status EventStatus @default(SAVED)

  scheduledPublishAt DateTime?
  publishedAt        DateTime?

  // Original creator.
  createdBy           String?
  createdByRole       String?
  createdByTenantType String?

  // Most recent user who performed Publish.
  lastPublishedBy           String?
  lastPublishedByRole       String?
  lastPublishedByTenantType String?

  // ALL / TENANT / ACTOR / TENANT_ACTOR /
  // ORGANIZATION_ACTOR / SPECIFIC
  lastPublishedAudienceMode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  audiences EventAudience[]

  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([scheduledPublishAt])
  @@index([createdBy])
  @@index([lastPublishedBy])
}

// ============================================================
// EVENT AUDIENCE
// ============================================================

model EventAudience {
  id String @id @default(cuid())

  eventId String

  // Examples:
  // TENANT -> Corporate
  // ROLE   -> Faculty / Trainer / Employee etc.
  // TARGET -> Corporate::Faculty
  // TARGET -> Corporate::Apex Global Pvt Ltd::Faculty
  audienceId String

  // TENANT / ROLE / TARGET / ORGANIZATION
  audienceType String?

  // Who published this audience target.
  // These fields are populated when the event is actually PUBLISHED.
  publishedBy           String?
  publishedByRole       String?
  publishedByTenantType String?
  publishedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, audienceId])
  @@index([eventId])
  @@index([audienceId])
  @@index([publishedBy])
}
